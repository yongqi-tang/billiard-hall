/* ===== 全局设计系统 ===== */
page {
  background: linear-gradient(180deg, #f6f8fc 0%, #eef1f7 100%);
  font-size: 28rpx;
  color: #1f2430;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.06);
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, #1a1a2e, #2d3a5f);
  color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(26, 26, 46, 0.25);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 46, 0.2);
}

.btn-primary::after {
  border: none;
}

/* 通用空态 */
.empty {
  text-align: center;
  padding: 120rpx 60rpx;
  color: #9aa0ad;
}

.empty-icon {
  font-size: 96rpx;
  opacity: 0.6;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
}

/* 顶部渐变标题（复用） */
.page-hero {
  background: linear-gradient(135deg, #1a1a2e 0%, #28345c 60%, #3b4a7a 100%);
  padding: 56rpx 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.page-hero::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}
