/* 全局样式 */
page {
  background: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 通用按钮 */
.btn-primary {
  background: #1a1a2e;
  color: #fff;
  border-radius: 12rpx;
}

.btn-primary::after {
  border: none;
}
