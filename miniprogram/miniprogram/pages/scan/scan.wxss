.container {
  padding: 60rpx 40rpx;
  min-height: 80vh;
  display: flex;
  flex-direction: column;
}

.scan-card {
  background: linear-gradient(160deg, #ffffff, #f6f8fc);
  border-radius: 32rpx;
  padding: 70rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 36rpx rgba(26, 26, 46, 0.1);
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.icon {
  font-size: 100rpx;
  animation: float 2.4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  margin-top: 24rpx;
}

.desc {
  font-size: 26rpx;
  color: #9aa0ad;
  line-height: 1.7;
  margin: 24rpx 0 48rpx;
}

.scan-btn {
  width: 100%;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 600;
}

.scan-btn[disabled] {
  opacity: 0.6;
}
