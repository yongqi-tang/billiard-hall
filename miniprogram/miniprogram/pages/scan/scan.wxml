<view class="container">
  <view class="scan-card">
    <view class="icon">🎯</view>
    <view class="title">扫描球台二维码</view>
    <view class="desc">
      请扫描球台上的二维码标签<br />
      开台后灯光自动亮起并开始计时<br />
      <text wx:if="{{hasReservation}}" style="color:#e08a00">您有可用预约，将自动核销开台</text>
    </view>
    <button class="btn-primary scan-btn" bindtap="scanCode" disabled="{{scanning}}">{{scanning ? '开台中...' : '开始扫码'}}</button>
  </view>
</view>
