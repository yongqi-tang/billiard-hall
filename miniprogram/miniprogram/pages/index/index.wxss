.container {
  padding-bottom: 40rpx;
}

.header {
  background: #1a1a2e;
  padding: 60rpx 40rpx;
  color: #fff;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 扫码入口 */
.scan-entry {
  display: flex;
  align-items: center;
  background: #fff;
  margin: -30rpx 20rpx 0;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.scan-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.scan-title {
  font-size: 32rpx;
  font-weight: bold;
}

.scan-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.scan-arrow {
  margin-left: auto;
  color: #ccc;
  font-size: 40rpx;
}

/* 球台列表 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin: 30rpx 20rpx 10rpx;
}

.table-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.table-card {
  width: calc(50% - 40rpx);
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.table-name {
  font-size: 30rpx;
  font-weight: bold;
}

.table-price {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.table-status {
  font-size: 24rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background: #ccc;
}

.table-card.free .dot {
  background: #07c160;
}

.table-card.free .table-status {
  color: #07c160;
}

.table-card.busy .dot {
  background: #fa5151;
}

.table-card.busy .table-status {
  color: #fa5151;
}

.table-card.other .dot {
  background: #ffc300;
}

.table-card.other .table-status {
  color: #ffc300;
}

.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 26rpx;
}
