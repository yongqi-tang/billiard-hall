.container {
  padding-bottom: 40rpx;
}

/* ===== 顶部品牌 ===== */
.header {
  background: linear-gradient(135deg, #14142b 0%, #1a1a2e 55%, #2d3a5f 100%);
  padding: 64rpx 40rpx 100rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.header-glow {
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12), transparent 70%);
}

.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 1rpx;
}

.badge {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 22rpx;
  backdrop-filter: blur(4rpx);
}

.badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #07c160;
  margin-right: 10rpx;
  animation: pulse 1.4s infinite;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(7, 193, 96, 0.5); }
  50% { box-shadow: 0 0 0 12rpx rgba(7, 193, 96, 0); }
}

/* ===== 操作入口 ===== */
.entry-row {
  display: flex;
  margin: -60rpx 24rpx 0;
  position: relative;
  z-index: 2;
}

.entry-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(26, 26, 46, 0.12);
  text-align: center;
  transition: transform 0.2s ease;
  animation: fadeUp 0.4s ease;
}

.entry-card:first-child {
  margin-right: 20rpx;
}

.entry-card:active {
  transform: scale(0.97);
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.entry-icon {
  font-size: 56rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 12rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: #9aa0ad;
  margin-top: 6rpx;
}

.entry-card.scan .entry-title { color: #1a1a2e; }
.entry-card.reserve .entry-title { color: #e08a00; }

/* ===== 球台列表 ===== */
.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 32rpx;
  font-weight: 700;
  margin: 36rpx 24rpx 8rpx;
}

.section-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #9aa0ad;
}

.table-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10rpx;
}

.table-card {
  width: calc(50% - 40rpx);
  margin: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.4s ease;
}

.table-card:active {
  transform: scale(0.97);
}

.table-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.table-card.free::before { background: #07c160; }
.table-card.busy::before { background: #fa5151; }
.table-card.repair::before { background: #8a8f99; }
.table-card.reserved::before { background: #ffb300; }

.table-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.table-name {
  font-size: 32rpx;
  font-weight: 700;
}

.table-tag {
  font-size: 18rpx;
  color: #e08a00;
  background: #fff3d6;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.table-price {
  font-size: 22rpx;
  color: #9aa0ad;
  margin-top: 10rpx;
}

.table-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.table-status {
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.table-status.free .dot { background: #07c160; }
.table-status.free { color: #07c160; }

.table-status.busy .dot { background: #fa5151; }
.table-status.busy { color: #fa5151; }

.table-status.repair .dot { background: #8a8f99; }
.table-status.repair { color: #8a8f99; }

.table-status.reserved .dot { background: #ffb300; }
.table-status.reserved { color: #e08a00; }

.table-arrow {
  font-size: 22rpx;
  color: #1a1a2e;
  background: #eef1f7;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

/* 空态 */
.empty {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 26rpx;
}
