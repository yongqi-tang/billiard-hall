.container {
  padding: 20rpx 0 40rpx;
}

.order-item {
  margin: 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.06);
  animation: fadeUp 0.3s ease;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-no {
  font-size: 24rpx;
  color: #9aa0ad;
}

.status {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 22rpx;
  background: #f0f2f7;
  color: #6b7280;
  font-weight: 500;
}

.status.s0 { background: #ffe9c8; color: #b26a00; }
.status.s1 { background: #d9f7e3; color: #07a04d; }
.status.s2 { background: #eee; color: #999; }
.status.s3 { background: #ffdada; color: #e53030; }

.order-body {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #8a8f99;
  line-height: 1.8;
}

.order-footer {
  margin-top: 14rpx;
  text-align: right;
  padding-top: 14rpx;
  border-top: 1rpx solid #f4f6fb;
}

.amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-icon { font-size: 80rpx; }
.empty-text { margin-top: 20rpx; }
