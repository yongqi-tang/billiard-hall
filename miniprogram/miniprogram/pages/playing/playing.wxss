.container {
  padding: 40rpx 30rpx;
}

.timer-card {
  background: linear-gradient(135deg, #14142b 0%, #1a1a2e 55%, #2d3a5f 100%);
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(26, 26, 46, 0.35);
  position: relative;
  overflow: hidden;
  animation: fadeUp 0.4s ease;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.timer-card::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.table-name {
  font-size: 34rpx;
  font-weight: 600;
  opacity: 0.9;
}

.timer {
  margin: 36rpx 0 24rpx;
  position: relative;
  z-index: 1;
}

.time {
  font-size: 92rpx;
  font-weight: 700;
  font-family: 'DIN Alternate', 'Roboto Mono', monospace;
  letter-spacing: 6rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
}

.amount {
  font-size: 30rpx;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.1);
  display: inline-block;
  border-radius: 30rpx;
  padding: 8rpx 28rpx;
}

.debt-tip {
  margin-top: 24rpx;
  background: rgba(255, 87, 87, 0.22);
  border-radius: 14rpx;
  padding: 14rpx;
  font-size: 24rpx;
  color: #ffb3b3;
  animation: pulseTip 1.4s infinite;
}

@keyframes pulseTip {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.75; }
}

.actions {
  margin-top: 44rpx;
}

.actions button {
  width: 100%;
  margin-bottom: 22rpx;
  border-radius: 18rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  transition: transform 0.15s ease;
}

.actions button:active {
  transform: scale(0.97);
}

.btn-extend {
  background: linear-gradient(135deg, #ffc300, #ffb300);
  color: #1a1a2e;
  box-shadow: 0 8rpx 20rpx rgba(255, 179, 0, 0.3);
}

.btn-settle {
  background: linear-gradient(135deg, #07c160, #06ad56);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.btn-cancel {
  background: #fff;
  color: #8a8f99;
  border: 2rpx solid #e5e7ed;
}

.actions button::after {
  border: none;
}

.tips {
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9aa0ad;
}

.empty {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  animation: float 2.4s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.empty-text {
  font-size: 30rpx;
  color: #9aa0ad;
  margin: 30rpx 0 44rpx;
}
