.container {
  padding: 20rpx 0 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: #1a1a2e;
  padding: 40rpx;
  color: #fff;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #2d2d44;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
}

.member {
  font-size: 24rpx;
  opacity: 0.7;
  margin-top: 8rpx;
}

.balance-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
}

.balance-label {
  font-size: 26rpx;
  color: #999;
}

.balance-num {
  font-size: 60rpx;
  font-weight: bold;
  margin: 12rpx 0 24rpx;
}

.recharge-btns {
  display: flex;
  justify-content: space-around;
}

.recharge-btn {
  background: #1a1a2e;
  color: #fff;
  font-size: 28rpx;
  border-radius: 10rpx;
  padding: 12rpx 36rpx;
  margin: 0;
}

.menu {
  margin: 20rpx;
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}
