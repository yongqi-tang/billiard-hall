.container {
  padding: 20rpx 0 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #14142b 0%, #1a1a2e 55%, #2d3a5f 100%);
  padding: 50rpx 40rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.user-card::after {
  content: '';
  position: absolute;
  right: -70rpx;
  bottom: -70rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b4a7a, #2d3a5f);
  border: 3rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  margin-right: 24rpx;
  position: relative;
  z-index: 1;
}

.user-info {
  position: relative;
  z-index: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
}

.member {
  font-size: 24rpx;
  opacity: 0.75;
  margin-top: 10rpx;
  background: rgba(255, 255, 255, 0.14);
  display: inline-block;
  border-radius: 16rpx;
  padding: 2rpx 16rpx;
}

.balance-card {
  background: linear-gradient(135deg, #ffffff, #f6f8fc);
  margin: -30rpx 24rpx 10rpx;
  border-radius: 24rpx;
  padding: 36rpx 30rpx;
  text-align: center;
  box-shadow: 0 10rpx 30rpx rgba(26, 26, 46, 0.1);
  position: relative;
  z-index: 2;
}

.balance-label {
  font-size: 26rpx;
  color: #9aa0ad;
}

.balance-num {
  font-size: 64rpx;
  font-weight: 800;
  margin: 12rpx 0 24rpx;
  background: linear-gradient(135deg, #1a1a2e, #2d3a5f);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.recharge-btns {
  display: flex;
  justify-content: space-around;
}

.recharge-btn {
  background: linear-gradient(135deg, #1a1a2e, #2d3a5f);
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 14rpx 40rpx;
  margin: 0;
  box-shadow: 0 6rpx 14rpx rgba(26, 26, 46, 0.2);
  transition: transform 0.15s ease;
}

.recharge-btn:active {
  transform: scale(0.95);
}

.recharge-btn::after {
  border: none;
}

.menu {
  margin: 20rpx 24rpx;
  padding: 0 28rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
  font-size: 30rpx;
  transition: background 0.15s ease;
}

.menu-item:active {
  background: #f8f9fc;
}

.menu-item:last-child {
  border-bottom: none;
}

.arrow {
  color: #ccc;
  font-size: 36rpx;
}
